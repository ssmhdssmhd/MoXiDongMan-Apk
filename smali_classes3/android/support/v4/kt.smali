    invoke-direct {p0, p1}, Lorg/bouncycastle/asn1/for;-><init>(Z)V

    return-void
.end method

.method public constructor <init>([B)V
    .locals 0

    invoke-direct {p0, p1}, Lorg/bouncycastle/asn1/for;-><init>([B)V

    return-void
.end method
